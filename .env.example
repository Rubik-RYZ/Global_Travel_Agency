# =====================================================================
# Variables de entorno — Illimani Global Travel S.R.L.
# Copiar este archivo a `.env` en la raíz y completar los valores.
# NUNCA commitear el .env real.
# =====================================================================

# ---------- Django ----------
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---------- PostgreSQL ----------
POSTGRES_DB=agencia_viajes
POSTGRES_USER=agencia
POSTGRES_PASSWORD=agencia_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- CORS / Frontend ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:5173

# ---------- JWT ----------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---------- Cloudinary (almacén de archivos — Fase 3b) ----------
# Un solo juego de credenciales para todo el equipo: quien clone el repo pone
# estos valores en su `.env`, reinicia el backend y ya puede subir imágenes.
# Sin ellos el sistema igual funciona: sólo se deshabilita la subida y las
# imágenes ya guardadas por URL (las del seed) se siguen viendo.
# Panel de Cloudinary → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Stripe (Sprint 4) ----------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Resend (correo transaccional — Fase 3b) ----------
# Sin dominio verificado, el remitente debe ser `onboarding@resend.dev` y los
# correos sólo llegan a la dirección con la que se creó la cuenta de Resend.
# Sin clave, el sistema sigue operando: cada envío se imprime en el log.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ---------- ExchangeRate-API (Sprint 4) ----------
EXCHANGERATE_API_KEY=
