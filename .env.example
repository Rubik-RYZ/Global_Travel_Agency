# =====================================================================
# Variables de entorno — Illimani Global Travel S.R.L.
# Copiar este archivo a `.env` en la raíz y completar los valores.
# NUNCA commitear el .env real.
# =====================================================================

# ---------- Django ----------
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---------- PostgreSQL ----------
POSTGRES_DB=agencia_viajes
POSTGRES_USER=agencia
POSTGRES_PASSWORD=agencia_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- CORS / Frontend ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# ---------- JWT ----------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---------- Cloudinary (Sprint 3+) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Stripe (Sprint 4) ----------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Resend (emails transaccionales) ----------
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@illimanitravel.bo

# ---------- ExchangeRate-API (Sprint 4) ----------
EXCHANGERATE_API_KEY=
